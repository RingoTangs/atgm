{
  "name": "atgm-monorepo",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "description": "game management system for asktao.",
  "author": "RingoTangs",
  "license": "MIT",
  "homepage": "https://github.com/RingoTangs/atgm#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/RingoTangs/atgm.git"
  },
  "bugs": {
    "url": "https://github.com/RingoTangs/atgm/issues"
  },
  "keywords": [
    "react",
    "vite",
    "typescript",
    "tanstack-router",
    "tanstack-query",
    "tailwindcss",
    "template"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test",
    "check:fix": "pnpm lint:fix && pnpm format:fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "8.3.0",
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@ringotangs/tsconfig": "^0.1.2",
    "@types/node": "^22.20.4",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
