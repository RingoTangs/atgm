{
  "name": "atgm-server",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "dev": "node --env-file=.env.local --watch --import tsx src/server.ts",
    "build": "cross-env NODE_ENV=production tsdown",
    "start": "node ./.output/server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^5.2.6",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "mysql2": "^3.24.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15"
  }
}
